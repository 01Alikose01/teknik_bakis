rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Trial koruması ────────────────────────────────────────────────────
    match /trials/{deviceId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['trialStart', 'trialConsumed'])
                    && request.resource.data.trialConsumed == false;
      allow update: if request.resource.data.trialStart == resource.data.trialStart
                    && request.resource.data.trialConsumed == true;
      allow delete: if false;
    }

    // ── Google Play Satın Alma Bildirimi (Client yazar, yetki üretmez) ─
    match /purchases/{deviceId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // ── Google Play Yetkilendirme / Entitlements (SADECE Cloud Function Yazar) ─
    // İstemciler (client) bu koleksiyona asla doğrudan yazamaz.
    // Yetki yalnızca Google Play Developer API doğrulaması sonrası Cloud Functions tarafından verilir.
    match /entitlements/{deviceId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Abonelik Token Kasası (Sadece Cloud Function erişebilir) ─────────
    match /subscription_tokens/{tokenId} {
      allow read: if false;
      allow write: if false;
    }

    // ── Temel göstergeler (Cloud Function yazar, uygulama okur) ──────────
    match /fundamentals/{ticker} {
      allow read:   if true;
      allow write:  if false;
    }

    // ── KAP Bildirimleri (Cloud Function yazar, uygulama okur) ──────────
    match /kap_disclosures/{docId} {
      allow read:   if true;
      allow write:  if false;
    }

    // ── KAP Şirket Listesi ────────────────────────────────────────────────
    match /kap_members/{docId} {
      allow read:   if true;
      allow write:  if false;
    }

    // ── KAP Sync Logları (sadece okuma) ─────────────────────────────────
    match /kap_sync_logs/{docId} {
      allow read:   if false; // sadece admin konsol
      allow write:  if false;
    }

    // ── Meta belge ────────────────────────────────────────────────────────
    match /meta/{doc} {
      allow read:   if true;
      allow write:  if false;
    }

    // ── Halka Arz (IPO) — Cloud Function yazar, uygulama okur ────────────
    match /ipo_items/{docId} {
      allow read:  if true;
      allow write: if false;
    }

    match /ipo_meta/{docId} {
      allow read:  if true;
      allow write: if false;
    }

    // ── Yapay Zeka Analiz Önbelleği — Cloud Function yazar, uygulama okur ─
    // Tüm kullanıcılar okuyabilir (önbellekten hızlı cevap).
    // Yazma sadece Cloud Function'dan (sunucu taraflı) yapılır.
    match /ai_cache/{cacheKey} {
      allow read:  if true;
      allow write: if false;
    }

    // ── BIST Hisse Senetleri (Cloud Function yazar, uygulama okur) ──────────
    match /bist_stocks/{symbol} {
      allow read:  if true;
      allow write: if false;
    }

    // ── BIST Endeks Meta (Cloud Function yazar, uygulama okur) ───────────────
    match /bist_index_meta/{docId} {
      allow read:  if true;
      allow write: if false;
    }

  }
}
